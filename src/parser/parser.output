    PAR_ABRE (273) 5 6 21 22 23 24 25 30 40 41
    PAR_CIERRA (274) 5 6 21 22 23 24 25 30 40 41
    LLAVE_ABRE (275) 7 26
    LLAVE_CIERRA (276) 7 26
    IF (277) 23 24
    ELSE (278) 24
    VAR (279) 10
    LOOP (280) 25
    UNTIL (281) 25
    OR (282) 49
    AND (283) 48
    WRITE (284) 21 22
    MAIN (285) 6
    RETURN (286) 20


